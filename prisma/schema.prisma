// Lake Evendim — Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth / Auth.js required tables) ───────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users & Identity ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed, null for SSO-only users
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?   // TOTP secret, encrypted at rest
  isActive      Boolean   @default(true)
  tokenVersion  Int       @default(0) // bumped to invalidate existing JWT sessions (deactivate/delete/role change)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  userRoles            UserRole[]
  userGroups           UserGroup[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  reviewedSuggestions  OrgMatchSuggestion[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // built-in roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
  groupRoles  GroupRole[]
}

model Permission {
  id       String @id @default(cuid())
  resource String // e.g. "users", "roles", "services"
  action   String // e.g. "read", "write", "delete", "admin"

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// A grant: a user holds a role, optionally scoped to one app and a subset of client orgs.
// appId null  = all apps (Admin-wide / global).
// scopeAllOrgs = true = every client org; false = limited to the orgs / orgGroups listed below.
model UserRole {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  appId        String?
  scopeAllOrgs Boolean  @default(true)
  createdAt    DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  app       App?               @relation(fields: [appId], references: [id], onDelete: Cascade)
  orgs      UserRoleOrg[]
  orgGroups UserRoleOrgGroup[]

  @@unique([userId, roleId, appId])
  @@index([userId])
  @@index([appId])
}

model UserRoleOrg {
  userRoleId String
  orgId      String

  userRole     UserRole     @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userRoleId, orgId])
  @@index([orgId])
}

model UserRoleOrgGroup {
  userRoleId String
  orgGroupId String

  userRole UserRole @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  orgGroup OrgGroup @relation(fields: [orgGroupId], references: [id], onDelete: Cascade)

  @@id([userRoleId, orgGroupId])
  @@index([orgGroupId])
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userGroups  UserGroup[]
  groupRoles  GroupRole[]
  ssoMappings SsoGroupMapping[]
}

model UserGroup {
  userId         String
  groupId        String
  ssoProvisioned Boolean @default(false) // true = written by SSO login sync; never delete manually-assigned rows
  ssoTenantId    String?  // which SsoTenant provisioned this; used to clean up stale memberships on login

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([ssoTenantId])
}

// A grant via group membership: same scope dimensions as UserRole.
model GroupRole {
  id           String   @id @default(cuid())
  groupId      String
  roleId       String
  appId        String?
  scopeAllOrgs Boolean  @default(true)
  createdAt    DateTime @default(now())

  group     Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role      Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  app       App?                @relation(fields: [appId], references: [id], onDelete: Cascade)
  orgs      GroupRoleOrg[]
  orgGroups GroupRoleOrgGroup[]

  @@unique([groupId, roleId, appId])
  @@index([groupId])
  @@index([appId])
}

model GroupRoleOrg {
  groupRoleId String
  orgId       String

  groupRole    GroupRole    @relation(fields: [groupRoleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([groupRoleId, orgId])
  @@index([orgId])
}

model GroupRoleOrgGroup {
  groupRoleId String
  orgGroupId  String

  groupRole GroupRole @relation(fields: [groupRoleId], references: [id], onDelete: Cascade)
  orgGroup  OrgGroup  @relation(fields: [orgGroupId], references: [id], onDelete: Cascade)

  @@id([groupRoleId, orgGroupId])
  @@index([orgGroupId])
}

// ─── Services / Integrations ──────────────────────────────────────────────────

enum ServiceStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
  DISABLED
}

enum SyncMode {
  POLLING
  WEBHOOK
}

model Service {
  id          String        @id @default(cuid())
  slug        String        @unique // e.g. "microsoft-365", "halopsa"
  name        String
  category    String        // e.g. "RMM", "PSA", "Licensing", "Security"
  status      ServiceStatus @default(DISCONNECTED)
  syncMode    SyncMode      @default(POLLING)
  config      Json?         // encrypted credential config
  lastSyncAt  DateTime?
  nextSyncAt  DateTime?
  pollInterval        Int?          // seconds between polls
  consecutiveFailures Int           @default(0)
  errorMessage        String?
  metadata            Json?         // logo URL, docs URL, etc.
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  syncLogs    ServiceSyncLog[]
}

model ServiceSyncLog {
  id          String   @id @default(cuid())
  serviceId   String
  status      String   // "success" | "error" | "partial"
  recordsIn   Int      @default(0)
  recordsOut  Int      @default(0)
  durationMs  Int?
  error       String?  @db.Text
  triggeredBy String?  // user id or "scheduler"
  startedAt   DateTime @default(now())
  completedAt DateTime?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

// ─── Organizations ────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  INACTIVE
  PENDING
  ARCHIVED
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  domains     String[]  // replaces single domain — multi-domain matching
  segment     String?   // "Financial", "Federal Contractors", "Health", "Law Firms" — Phase 4 grouping
  industry    String?
  tier        String?   // "standard", "professional", "enterprise"
  status      OrgStatus @default(ACTIVE)
  notes       String?   @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mappings         OrgMapping[]
  orgGroups        OrgGroupMember[]
  tickets          Ticket[]
  securityEvents   SecurityEvent[]
  cloudUsers       CloudUser[]
  userRoleScopes   UserRoleOrg[]
  groupRoleScopes  GroupRoleOrg[]
  ssoTenants       SsoTenant[]
  domainAuths      OrgDomainAuth[]
  matchSuggestions OrgMatchSuggestion[]
}

model OrgMapping {
  id            String   @id @default(cuid())
  orgId         String
  serviceSlug   String
  externalId    String
  externalName  String?
  confidence    Int      @default(100)
  isConfirmed   Boolean  @default(false)
  matcherKey    String?  // "entra_tid" | "verified_domain" | "domain" | "name" | "halopsa_source" | "manual"
  wasAutoLinked Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  matchSuggestion OrgMatchSuggestion?

  @@unique([serviceSlug, externalId])
}

model OrgGroup {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?
  color         String?       // hex color for badge
  mode          OrgGroupMode  @default(MANUAL)
  ruleAttribute String?       // "segment" (future: "tier", "status", …)
  ruleValue     String?       // e.g. "Financial", "Federal"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  members OrgGroupMember[]
  userRoleScopes  UserRoleOrgGroup[]
  groupRoleScopes GroupRoleOrgGroup[]
}

model OrgGroupMember {
  orgId      String
  orgGroupId String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgGroup     OrgGroup     @relation(fields: [orgGroupId], references: [id], onDelete: Cascade)

  @@id([orgId, orgGroupId])
}

enum OrgGroupMode {
  MANUAL
  RULE_BASED
}

enum OrgSuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum DataDomain {
  IDENTITY
  VULNERABILITY
  COMPLIANCE
  OPERATIONS
}

enum DomainAuthStatus {
  UNKNOWN
  AUTHORIZED
  NOT_AUTHORIZED
}

// One row per (serviceSlug, externalId) — the engine's candidate match queue.
// PENDING = awaiting review; CONFIRMED = mapping created; REJECTED = suppressed forever.
// @@unique ensures the same external entity never spawns duplicate suggestions.
model OrgMatchSuggestion {
  id            String              @id @default(cuid())
  orgId         String
  serviceSlug   String
  externalId    String
  externalName  String?
  confidence    Int
  matcherKey    String              // "entra_tid" | "verified_domain" | "domain" | "name"
  matchEvidence Json?
  status        OrgSuggestionStatus @default(PENDING)
  orgMappingId  String?             @unique  // set on CONFIRMED — links to the created OrgMapping
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  orgMapping   OrgMapping?  @relation(fields: [orgMappingId], references: [id], onDelete: SetNull)

  @@unique([serviceSlug, externalId])
  @@index([orgId])
  @@index([status])
}

// Per-client authorization for each data domain (IDENTITY, VULNERABILITY, COMPLIANCE, OPERATIONS).
// UNKNOWN = awaiting client authorization — must be excluded from scoring.
// AUTHORIZED / NOT_AUTHORIZED are both explicit states with different display treatment.
model OrgDomainAuth {
  id           String          @id @default(cuid())
  orgId        String
  domain       DataDomain
  status       DomainAuthStatus @default(UNKNOWN)
  authorizedAt DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, domain])
}

// ─── SSO Configuration (multi-tenant) ────────────────────────────────────────

// One row per Entra tenant (QCT internal + each client tenant).
// tenantId is the verified trust anchor (Entra `tid` JWT claim) — NOT the email domain.
// clientId/clientSecret are nullable: null = inherit QCT env-var app creds (default).
// Per-tenant overrides are the escape hatch for clients requiring their own app registration.
model SsoTenant {
  id           String   @id @default(cuid())
  provider     String   @default("microsoft-entra-id")
  name         String   // display name, e.g. "QCT Internal" or client name
  tenantId     String   @unique // Entra tid — NOT NULL; required before enabling
  clientId     String?  // null = use AUTH_MICROSOFT_ENTRA_ID_ID env var
  clientSecret String?  // encrypted via crypto.ts; null = use env var
  domains      String[] // secondary check + Phase 3 client-matching signal
  isEnabled    Boolean  @default(false)
  isDefault    Boolean  @default(false) // true = QCT's own tenant (only one)
  orgId        String?  // FK to Organization; null for QCT's own tenant
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization  Organization?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  groupMappings SsoGroupMapping[]
}

// Maps an Entra group object ID → a Lake Evendim Group (which carries GroupRole grants).
// entraGroupId is the trust anchor (immutable object ID), NOT the display name.
// Removing this mapping removes SSO access for users in that Entra group on next login.
model SsoGroupMapping {
  id             String   @id @default(cuid())
  ssoTenantId    String
  entraGroupId   String   // Entra group object ID
  entraGroupName String?  // informational display name only — can change in Entra
  groupId        String   // FK to Group (Phase 1 RBAC: GroupRole grants resolve here)
  createdAt      DateTime @default(now())

  ssoTenant SsoTenant @relation(fields: [ssoTenantId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([ssoTenantId, entraGroupId])
  @@index([groupId])
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model ApiKey {
  id          String       @id @default(cuid())
  name        String
  keyHash     String       @unique // SHA-256 hash of the actual key
  keyPrefix   String       // first 8 chars shown in UI (e.g. "le_live_")
  status      ApiKeyStatus @default(ACTIVE)
  scopes      String[]     // e.g. ["read:orgs", "write:orgs"]
  userId      String?      // nullable — key may be system-level
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Applications ─────────────────────────────────────────────────────────────

enum AppStatus {
  ACTIVE
  INACTIVE
  BETA
  DEPRECATED
}

model App {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  url         String?
  logoUrl     String?
  status      AppStatus @default(ACTIVE)
  isInternal  Boolean   @default(true)
  scopes      String[]  // what data lake resources it can access
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userRoles  UserRole[]  // role grants scoped to this app
  groupRoles GroupRole[]
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. "user.created", "service.sync", "api_key.revoked"
  resource   String   // e.g. "user", "service", "org"
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([resource])
}

// ─── MSP Data Lake — Service-synced records ───────────────────────────────────

model Ticket {
  id                String        @id @default(cuid())
  serviceSlug       String        // "halopsa"
  externalId        String
  orgId             String?
  orgMappingId      String?       // set by backfill; tracks which OrgMapping assigned orgId
  title             String
  description       String?       @db.Text
  status            String        // "open", "pending", "closed", etc.
  priority          String?       // "low", "medium", "high", "critical"
  type              String?
  assignee          String?
  requester         String?
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  rawData           Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([serviceSlug, externalId])
  @@index([orgId])
  @@index([orgMappingId])
  @@index([status])
  @@index([serviceSlug])
}

model SecurityEvent {
  id                String        @id @default(cuid())
  serviceSlug       String        // "todyl"
  externalId        String
  orgId             String?
  orgMappingId      String?       // set by backfill; tracks which OrgMapping assigned orgId
  type              String        // "alert", "incident", "threat"
  severity          String        // "critical", "high", "medium", "low", "info"
  title             String
  description       String?       @db.Text
  status            String        @default("open") // "open", "investigating", "resolved"
  source            String?       // sub-service that fired (e.g., "EDR", "SIEM", "Firewall")
  affectedAsset     String?
  resolvedAt        DateTime?
  externalCreatedAt DateTime?
  rawData           Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([serviceSlug, externalId])
  @@index([orgId])
  @@index([orgMappingId])
  @@index([severity])
  @@index([status])
  @@index([serviceSlug])
}

model CloudUser {
  id                String        @id @default(cuid())
  serviceSlug       String        // "microsoft-365"
  externalId        String
  orgId             String?
  orgMappingId      String?       // set by backfill; tracks which OrgMapping assigned orgId
  displayName       String?
  email             String?
  jobTitle          String?
  department        String?
  isLicensed        Boolean       @default(false)
  isEnabled         Boolean       @default(true)
  mfaEnabled        Boolean?
  licenses          String[]      // license SKU display names
  externalCreatedAt DateTime?
  rawData           Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([serviceSlug, externalId])
  @@index([orgId])
  @@index([orgMappingId])
  @@index([email])
  @@index([serviceSlug])
}
